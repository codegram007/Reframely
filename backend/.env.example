NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# Comma-separated browser origins allowed to call the API directly.
# Use your exact Netlify/custom domains in production (or * for public API CORS).
CORS_ORIGINS=http://localhost:5173,https://reframelyai.netlify.app

DATABASE_URL=postgres://reframely:reframely@localhost:5432/reframely

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=reframely-dev

# Deploy preview URL base (B10)
DEPLOY_BASE_URL=https://preview.reframely.app

# Optional — without this the AI agent uses the heuristic proposer (B12)
# ANTHROPIC_API_KEY=

# Authentication (B14). Production must use "on"; "dev" injects local-user.
AUTH_MODE=dev
# Required when AUTH_MODE=on. Never expose the service-role key to Vite.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Local no-Docker backends (recommended when Postgres/MinIO are not running):
# STORAGE_BACKEND=fs
# IMPORT_REPO_BACKEND=file
# LOCAL_DATA_DIR=.data
