NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgres://vibestudio:vibestudio@localhost:5432/vibestudio

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vibestudio-dev

# Deploy preview URL base (B10)
DEPLOY_BASE_URL=https://preview.vibestudio.app

# Optional — without this the AI agent uses the heuristic proposer (B12)
# ANTHROPIC_API_KEY=

# Authentication (B14). Use "dev" locally and "clerk" in production.
AUTH_MODE=dev
AUTH_DEV_SECRET=vibestudio-local-dev-secret-change-me

# Required when AUTH_MODE=clerk
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUDIENCE=

# Local no-Docker backends (recommended when Postgres/MinIO are not running):
# STORAGE_BACKEND=fs
# IMPORT_REPO_BACKEND=file
# LOCAL_DATA_DIR=.data
