{
  "name": "reframely-backend",
  "version": "0.1.0",
  "description": "Reframely backend — import, classification, codegen, storage, deploy, and AI agent services",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.0",
    "@supabase/supabase-js": "^2.111.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "fflate": "^0.8.3",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
